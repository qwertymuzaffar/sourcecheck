{
  "name": "sourcecheck",
  "version": "0.1.1",
  "description": "Check that every claim an LLM makes points at a real passage in your sources. Locates quotes exactly, after normalization, or fuzzily with offsets; grades claims supported, partial or unsupported; verifies extracted fields against their evidence; optional model judge; citation prompts and parsers; Markdown reports; zero dependencies.",
  "keywords": [
    "citations",
    "grounding",
    "hallucination",
    "rag",
    "llm",
    "evidence",
    "provenance",
    "source-tracking",
    "fact-checking",
    "structured-extraction",
    "evaluation",
    "typescript"
  ],
  "license": "MIT",
  "author": "Muzaffar Qosimov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwertymuzaffar/sourcecheck.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.8"
  }
}
